/// TAPD 项目信息
model TapdWorkspace {
  id        String   @id @map("id")
  name      String   @map("name")
  status    String?  @map("status")
  syncedAt  DateTime @map("synced_at") @default(now())

  @@map("tapd_workspace")
}

/// TAPD 同步记录
model TapdSyncRecord {
  id             String    @id @default(cuid()) @map("id")
  syncType       String    @map("sync_type") @default("full")
  workspaceIds   Json      @map("workspace_ids") @default("[]")
  dataTypes      Json      @map("data_types") @default("[\"story\", \"task\", \"iteration\"]")
  status         String    @map("status") @default("running")
  progress       Int       @map("progress") @default(0)
  storyCount     Int       @map("story_count") @default(0)
  taskCount      Int       @map("task_count") @default(0)
  iterationCount Int       @map("iteration_count") @default(0)
  bugCount       Int       @map("bug_count") @default(0)
  timesheetCount Int       @map("timesheet_count") @default(0)
  errorMsg       String?   @map("error_msg")
  startedAt      DateTime  @map("started_at") @default(now())
  finishedAt     DateTime? @map("finished_at")
  createdBy      String?   @map("created_by")

  @@index([status])
  @@index([startedAt])
  @@map("tapd_sync_record")
}

/// TAPD 自动同步配置
model AutoSyncConfig {
  id               String    @id @default(cuid()) @map("id")
  
  isEnabled        Boolean   @map("is_enabled") @default(true)
  name             String    @map("name") @default("默认自动同步")
  
  syncTimes        Json      @map("sync_times") @default("[\"02:00\"]")
  timezone         String    @map("timezone") @default("Asia/Shanghai")
  
  defaultDaysBack  Int       @map("default_days_back") @default(90)
  dataTypes        Json      @map("data_types") @default("[\"story\",\"task\",\"iteration\"]")
  workspaceIds     Json?     @map("workspace_ids")
  
  syncStrategy     String    @map("sync_strategy") @default("incremental")
  retryOnFailure   Boolean   @map("retry_on_failure") @default(true)
  maxRetries       Int       @map("max_retries") @default(3)
  
  notifyOnComplete Boolean   @map("notify_on_complete") @default(false)
  notifyOnError     Boolean   @map("notify_on_error") @default(true)
  notifyChannels    Json?     @map("notify_channels")
  
  lastExecutedAt   DateTime? @map("last_executed_at")
  lastStatus       String?   @map("last_status")
  nextExecuteAt    DateTime? @map("next_execute_at")
  createdAt        DateTime  @map("created_at") @default(now())
  updatedAt        DateTime  @map("updated_at") @updatedAt
  createdBy        String?   @map("created_by")
  
  @@index([isEnabled])
  @@index([lastExecutedAt])
  @@map("auto_sync_config")
}

