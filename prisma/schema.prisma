// ============================================================
// TAPD 工作流状态映射表（用于状态转换）
// ============================================================

/// TAPD 工作流状态映射
/// 存储每个项目的工作流配置，用于将TAPD原始状态转换为中文显示
model TapdWorkflowStatus {
  id            Int      @id @default(autoincrement())
  workspaceId   String   @map("workspace_id")
  workspaceName String?  @map("workspace_name")
  system        String   @map("system") @default("story") // story | bug
  statusKey     String   @map("status_key") // 原始值: resolved, status_6, for_test...
  statusValue   String   @map("status_value") // 中文显示: 已实现, 待发布, 待测试...
  sortOrder     Int      @map("sort_order") @default(0)
  isActive      Boolean  @map("is_active") @default(true)
  version       String?  @map("version") // TAPD工作流版本号
  syncedAt      DateTime @map("synced_at") @default(now())
  createdAt     DateTime @map("created_at") @default(now())
  updatedAt     DateTime @map("updated_at") @updatedAt

  @@unique([workspaceId, system, statusKey])
  @@index([workspaceId])
  @@index([system])
  @@index([statusKey])
  @@map("tapd_workflow_status")
}

/// TAPD 工作流同步日志
/// 记录每次从TAPD API获取工作流配置的操作
model TapdWorkflowSyncLog {
  id           Int      @id @default(autoincrement())
  workspaceId  String   @map("workspace_id")
  action       String   @map("action") // init | refresh | force_refresh
  status       String   @map("status") // success | failed | skipped
  recordsCount Int      @map("records_count") @default(0)
  errorMessage String?  @map("error_message")
  durationMs   Int?     @map("duration_ms")
  createdAt    DateTime @map("created_at") @default(now())

  @@index([workspaceId])
  @@index([createdAt])
  @@map("tapd_workflow_sync_log")
}

/// TAPD 角色人员映射
/// 存储 TAPD 项目中成员姓名与 4 大研发角色（后端/前端/移动端/测试）的归属关系
/// 用于将需求 owner 自动归类到对应角色，计算各角色工作量
model TapdMemberRoleMapping {
  id          Int      @id @default(autoincrement())
  workspaceId String   @map("workspace_id")      // TAPD 项目ID
  memberName  String   @map("member_name")       // 真实姓名(与 owner 字段匹配)
  role        String   @map("role")              // 后端/前端/移动端/测试/PO/UED/借调人员/其他
  roleId      String?  @map("role_id")           // TAPD 角色ID(如 1137329286001000590)
  isActive    Boolean  @map("is_active") @default(true)
  remark      String?  @map("remark")
  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @updatedAt

  @@unique([workspaceId, memberName, role])
  @@index([workspaceId])
  @@index([memberName])
  @@map("tapd_member_role_mapping")
}

/// TAPD 项目角色配置
/// 存储每个项目的角色列表（通过 /roles 接口同步）
model TapdProjectRole {
  id          Int      @id @default(autoincrement())
  workspaceId String   @map("workspace_id")
  roleId      String   @map("role_id")           // TAPD 角色ID
  roleName    String   @map("role_name")         // 角色名称
  isSystem    Boolean  @map("is_system") @default(false)  // 是否系统内置角色
  isActive    Boolean  @map("is_active") @default(true)
  syncedAt    DateTime @map("synced_at") @default(now())
  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @updatedAt

  @@unique([workspaceId, roleId])
  @@index([workspaceId])
  @@map("tapd_project_role")
}

/// 分析报告历史记录
model AnalysisReport {
  id          String   @id @default(cuid()) @map("id")
  title       String   @map("title")
  meta        String?  @map("meta")           // 查询条件描述
  mode        String   @map("mode")           // natural | advanced
  projects    Json     @map("projects")       // 项目ID列表
  dateStart   String   @map("date_start")
  dateEnd     String   @map("date_end")
  status      String?  @map("status")         // 状态筛选
  reportType  String   @map("report_type")    // full | summary | trend
  htmlContent String   @map("html_content")   // 完整HTML报告内容
  metadata    Json     @map("metadata")       // KPI等元数据JSON
  createdBy   String?  @map("created_by")

  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @updatedAt

  @@index([createdAt])
  @@map("analysis_report")
}

// ============================================================
// TAPD 项目级配置（字段映射 + 自定义设置）
// ============================================================

/// TAPD项目配置
/// 用于存储每个TAPD项目的特殊字段映射（如优先级字段、提测时间字段等）
model TapdProjectConfig {
  id              String   @id @default(cuid()) @map("id")
  
  // 项目标识
  workspaceId     String   @unique @map("workspace_id")    // TAPD项目ID
  projectName     String?  @map("project_name")            // 项目名称（缓存，便于查看）
  
  // 字段映射配置（JSON格式，灵活扩展）
  /// 优先级字段映射
  priorityField   String?  @map("priority_field")          // 优先级字段名（如：custom_field_four, priority）
  priorityFieldType String? @map("priority_field_type")    // 优先级字段类型：number | text
  
  /// 提测时间字段映射
  testDateField   String?  @map("test_date_field")         // 提测时间字段名
  
  /// 其他自定义字段映射（JSON对象）
  customFieldMappings Json?   @map("custom_field_mappings") // {"field_key": "tapd_field_name"}
  
  // 自动检测结果缓存
  autoDetectedAt  DateTime? @map("auto_detected_at")       // 最后自动检测时间
  detectionConfidence Float?  @map("detection_confidence") // 检测置信度 (0-1)
  
  // 状态
  isActive        Boolean  @default(true) @map("is_active") // 是否启用
  isAutoDetected  Boolean  @default(false) @map("is_auto_detected") // 是否为自动检测结果
  
  // 审计
  createdBy       String?  @map("created_by")              // 创建人/来源
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([isActive])
  @@map("tapd_project_config")
}
